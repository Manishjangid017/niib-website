# =====================================================
# NIIB Institute - Apache Configuration
# Works unchanged in both local subfolder and live root deployments.
# All rewrite targets are relative (resolved against this .htaccess
# directory) or constructed from %{REQUEST_URI} so no base path is
# hardcoded.
# =====================================================

Options -Indexes -MultiViews
ServerSignature Off

# Hide sensitive files
<FilesMatch "^(\.htaccess|\.htpasswd|\.env|composer\.json|composer\.lock|README\.md|.*\.sql|.*\.log)$">
    Require all denied
</FilesMatch>

RewriteEngine On
# No RewriteBase — Apache uses the .htaccess directory as the implicit
# base, so relative targets resolve correctly in subfolder OR at root.

# =====================================================
# Canonical host: force www -> non-www over HTTPS.
# Condition matches ONLY the www host, so it never loops on the apex.
# =====================================================
RewriteCond %{HTTP_HOST} ^www\.newimageinstitute\.com$ [NC]
RewriteRule ^(.*)$ https://newimageinstitute.com/$1 [R=301,L,NE]

# =====================================================
# Force canonical scheme + host (uncomment for production)
# =====================================================
# Force HTTPS
# RewriteCond %{HTTPS} off
# RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301,NE]
# Force non-www (or vice versa)
# RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
# RewriteRule ^(.*)$ https://%1/$1 [L,R=301,NE]

# Protect sensitive directories
RewriteRule ^(config|includes|database)/?(.*)$ - [F,L]

# Remove .php extension from public scripts.
# /about.php → /about (canonical). %1 is captured from THE_REQUEST which
# includes the full request path with leading slash — works in any base.
RewriteCond %{THE_REQUEST} \s([^?\s]+?)\.php[\s?] [NC]
RewriteCond %{REQUEST_URI} !/(admin|api|database|includes|config)/
RewriteRule ^ %1 [R=301,L,NE]

# Remove trailing slash for non-directories (consistency).
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_URI} ^(.+)/$
RewriteRule ^ %1 [R=301,L,NE]

# Legacy /page/{slug} → /{slug} (preserves subfolder prefix if any).
RewriteCond %{REQUEST_URI} ^(.*?)/page/([a-zA-Z0-9_-]+)/?$
RewriteRule ^ %1/%2 [R=301,L,NE]

# Clean URLs
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d

# /course/{slug}
RewriteRule ^course/([a-zA-Z0-9_-]+)/?$ course-details.php?slug=$1 [L,QSA]

# /blog/{slug}
RewriteRule ^blog/([a-zA-Z0-9_-]+)/?$ blog-details.php?slug=$1 [L,QSA]

# Static slug routes (must come BEFORE the dynamic catch-all so they win)
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^about/?$ about.php [L,QSA]
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^contact/?$ contact.php [L,QSA]
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^courses/?$ courses.php [L,QSA]
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^blog/?$ blog.php [L,QSA]
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^placement/?$ placement.php [L,QSA]
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^locations/?$ locations.php [L,QSA]
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^franchise/?$ franchise.php [L,QSA]

# Sitemap & robots
RewriteRule ^sitemap\.xml$ sitemap.php [L]
RewriteRule ^robots\.txt$ robots.php [L]

# Dynamic page catch-all (SEO-friendly /{slug}).
# Place LAST so all hardcoded routes (and existing files/dirs) win first.
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^([a-zA-Z0-9_-]+)/?$ page.php?slug=$1 [L,QSA]

# Final 404 fallback: any unmatched non-file request serves 404.php
# (relative target resolves to this .htaccess directory in any base).
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule . 404.php [L]

# =====================================================
# Performance — Gzip / Brotli compression
# =====================================================
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript
    AddOutputFilterByType DEFLATE application/javascript application/x-javascript
    AddOutputFilterByType DEFLATE application/json application/xml application/rss+xml application/atom+xml
    AddOutputFilterByType DEFLATE application/ld+json application/manifest+json
    AddOutputFilterByType DEFLATE image/svg+xml image/x-icon
    AddOutputFilterByType DEFLATE font/woff font/woff2 application/font-woff application/font-woff2
</IfModule>
<IfModule mod_brotli.c>
    AddOutputFilterByType BROTLI_COMPRESS text/html text/plain text/css application/javascript application/json application/xml image/svg+xml
</IfModule>

# =====================================================
# Browser caching — long for static, short for HTML
# =====================================================
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresDefault                              "access plus 1 month"

    # HTML pages — short cache so SEO updates propagate fast
    ExpiresByType text/html                     "access plus 0 seconds"
    ExpiresByType application/xhtml+xml         "access plus 0 seconds"

    # XML / RSS / Sitemap
    ExpiresByType application/xml               "access plus 1 hour"
    ExpiresByType application/rss+xml           "access plus 1 hour"
    ExpiresByType application/atom+xml          "access plus 1 hour"
    ExpiresByType text/xml                      "access plus 1 hour"

    # Images
    ExpiresByType image/jpg                     "access plus 1 year"
    ExpiresByType image/jpeg                    "access plus 1 year"
    ExpiresByType image/gif                     "access plus 1 year"
    ExpiresByType image/png                     "access plus 1 year"
    ExpiresByType image/webp                    "access plus 1 year"
    ExpiresByType image/avif                    "access plus 1 year"
    ExpiresByType image/svg+xml                 "access plus 1 year"
    ExpiresByType image/x-icon                  "access plus 1 year"
    ExpiresByType image/vnd.microsoft.icon      "access plus 1 year"

    # CSS / JS
    ExpiresByType text/css                      "access plus 1 month"
    ExpiresByType application/javascript        "access plus 1 month"
    ExpiresByType text/javascript                "access plus 1 month"

    # Fonts
    ExpiresByType font/ttf                      "access plus 1 year"
    ExpiresByType font/otf                      "access plus 1 year"
    ExpiresByType font/woff                     "access plus 1 year"
    ExpiresByType font/woff2                    "access plus 1 year"
    ExpiresByType application/font-woff         "access plus 1 year"
    ExpiresByType application/x-font-ttf        "access plus 1 year"

    # Documents
    ExpiresByType application/pdf               "access plus 1 month"
</IfModule>

# =====================================================
# Security + SEO headers
# =====================================================
<IfModule mod_headers.c>
    # Security
    Header set X-Content-Type-Options          "nosniff"
    Header set X-Frame-Options                 "SAMEORIGIN"
    Header set X-XSS-Protection                "1; mode=block"
    Header set Referrer-Policy                 "strict-origin-when-cross-origin"
    Header set Permissions-Policy              "geolocation=(), microphone=(), camera=()"
    Header set X-Permitted-Cross-Domain-Policies "none"

    # HSTS (enable only when on HTTPS)
    # Header always set Strict-Transport-Security "max-age=63072000; includeSubDomains; preload"

    # Cache static assets aggressively
    <FilesMatch "\.(jpg|jpeg|png|gif|webp|avif|svg|ico|css|js|woff|woff2|ttf|otf|eot)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
        Header unset ETag
    </FilesMatch>
    FileETag None

    # Vary header for compressed content
    <FilesMatch "\.(css|js|html|svg|xml|json)$">
        Header append Vary "Accept-Encoding"
    </FilesMatch>

    # Prevent caching of HTML so updates ship instantly
    <FilesMatch "\.(php|html)$">
        Header set Cache-Control "no-cache, must-revalidate, max-age=0"
    </FilesMatch>
</IfModule>

# =====================================================
# Default
# =====================================================
DirectoryIndex index.php index.html
# 404 served by the final mod_rewrite fallback above, so it works
# regardless of subfolder vs root deployment. No ErrorDocument needed.

# Block bad bots / scrapers (optional — uncomment as needed)
# <IfModule mod_rewrite.c>
#     RewriteCond %{HTTP_USER_AGENT} (ahrefsbot|semrushbot|mj12bot|dotbot|petalbot) [NC]
#     RewriteRule .* - [F,L]
# </IfModule>
